# Production .env for PythonAnywhere
# Copy this to .env on the server and fill in all values.
# Do NOT commit the real .env to git.

# ── Django core ────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=<generate-a-strong-random-key>
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=daswanson22.pythonanywhere.com,thefantasylab.com,www.thefantasylab.com

# PythonAnywhere terminates SSL at its proxy — these two settings let Django
# detect the real scheme and hostname from the forwarded headers.
DJANGO_TRUST_PROXY_SSL_HEADER=True
DJANGO_USE_X_FORWARDED_HOST=True

# ── MySQL database ─────────────────────────────────────────────────────────────
MYSQL_NAME=daswanson22$swantech
MYSQL_USER=daswanson22
MYSQL_PASSWORD=<your-mysql-password>
MYSQL_HOST=daswanson22.mysql.pythonanywhere-services.com
MYSQL_PORT=3306

# ── Yahoo OAuth2 ───────────────────────────────────────────────────────────────
YAHOO_CLIENT_ID=<your-yahoo-client-id>
YAHOO_CLIENT_SECRET=<your-yahoo-client-secret>

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=<sk_live_...>
STRIPE_PUBLISHABLE_KEY=<pk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>
STRIPE_PRICE_PRO=<price_...>
STRIPE_PRICE_ELITE=<price_...>

# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=admin@swantech.org
EMAIL_HOST_PASSWORD=<gmail-app-password>
DEFAULT_FROM_EMAIL=thefantasylab@swantech.org
